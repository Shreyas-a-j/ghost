#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

PID_FILE=".ghost/dev.pid"
LOG_FILE=".ghost/dev.log"
RUN_CMD={{ run_cmd_quoted }}

is_running() {
  [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

case "${1:-status}" in
  start)
    if [ -z "$RUN_CMD" ]; then
      echo "no run command configured"
      exit 1
    fi
    if [ -f "$PID_FILE" ]; then
      pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if is_running "$pid"; then
        echo "dev server already running (pid $pid)"
        exit 1
      fi
      rm -f "$PID_FILE"
    fi
    mkdir -p .ghost
    setsid bash -c "$RUN_CMD" >>"$LOG_FILE" 2>&1 &
    pid=$!
    echo "$pid" >"$PID_FILE"
    echo "dev server started (pid $pid); logs: $LOG_FILE"
    ;;
  stop)
    if [ ! -f "$PID_FILE" ]; then
      echo "dev server not running"
      exit 0
    fi
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -z "$pid" ]; then
      rm -f "$PID_FILE"
      echo "dev server not running"
      exit 0
    fi
    if is_running "$pid"; then
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
      for _ in 1 2 3; do
        is_running "$pid" || break
        sleep 1
      done
      if is_running "$pid"; then
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
      fi
      echo "dev server stopped (pid $pid)"
    else
      echo "dev server not running"
    fi
    rm -f "$PID_FILE"
    ;;
  status)
    if [ -f "$PID_FILE" ]; then
      pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if is_running "$pid"; then
        echo "running (pid $pid)"
      else
        echo "stopped (stale pid file)"
      fi
    else
      echo "stopped"
    fi
    echo "--- last log lines ---"
    tail -n 5 "$LOG_FILE" 2>/dev/null || true
    ;;
  *)
    echo "usage: scripts/dev.sh start|stop|status"
    exit 2
    ;;
esac
